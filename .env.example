# AudioRepurpose local development environment
# Copy this file to .env.local and fill in the values you actually need.

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=localhost

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_ACCESS_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY_OPTIN=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Legacy script compatibility only
# Some older scripts still reference OPENAI_API_KEY directly.
OPENAI_API_KEY=

# Billing
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Internal auth / maintenance
CRON_SECRET=
INTERNAL_JOB_SECRET=
UPLOAD_TOKEN_SECRET=

# Admin / demo
ADMIN_EMAILS=
DEMO_EMAIL=
DEMO_PASSWORD=
NEXT_PUBLIC_DEMO_PASSWORD=
DEMO_RESEED_SECRET=

# Pipeline doc allowlist
PIPELINE_DOC_ALLOWED_EMAILS=
NEXT_PUBLIC_PIPELINE_DOC_ALLOWED_EMAILS=

# Integrations
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional app tuning
COST_MARKUP_PERCENTAGE=35
PERFORMANCE_LEVEL=
NEXT_PUBLIC_SAVE_EXPORT_LOCALLY=false
