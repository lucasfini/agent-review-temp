# AudioRepurpose local development environment
# Copy this file to .env.local and fill in the values you actually need.

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=localhost
# Required by the Caddy production config only.
ACME_EMAIL=
# Optional server-to-server base URL override. Leave blank to use app defaults.
INTERNAL_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_ACCESS_KEY=
OPENAI_API_KEY=
# Backward compatibility only for older references.
OPENAI_API_KEY_OPTIN=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Anthropic is optional. Leave it blank if the app is OpenAI-only.

# Billing
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" to run billing checkout/portal flows without a Stripe key in local testing.
BILLING_TEST_MODE=
# Subscription Stripe price IDs are stored in plans.stripe_price_id, not env vars.
# dry_run reports entitlement decisions without blocking existing credit/pay-as-you-go flows.
SUBSCRIPTION_ENFORCEMENT_MODE=dry_run
# Optional subscription redirect overrides. Leave blank to use app defaults.
STRIPE_SUBSCRIPTION_SUCCESS_URL=
STRIPE_SUBSCRIPTION_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=

# Contact email delivery (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=support@audiorepurpose.com
CONTACT_TO_EMAIL=support@audiorepurpose.com
# Optional: only needed for paused legacy agency lead-capture APIs.
AGENCY_LEAD_FROM_EMAIL=
AGENCY_LEAD_NOTIFICATION_EMAIL=
# Set only if those legacy APIs are intentionally active.
AGENCY_LEAD_ORGANIZATION_ID=

# Optional private internal agency Slack integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/agency/slack/oauth/callback
# Optional explicit OAuth state secret; defaults to INTEGRATIONS_ENCRYPTION_KEY or SLACK_CLIENT_SECRET.
SLACK_OAUTH_STATE_SECRET=
# Not currently used unless Slack events/interactivity are added.
SLACK_SIGNING_SECRET=

# Integration token encryption
# Generate 32 bytes as base64 or 64 hex chars. Never commit a real value.
INTEGRATIONS_ENCRYPTION_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Internal auth / maintenance
CRON_SECRET=
INTERNAL_JOB_SECRET=
UPLOAD_TOKEN_SECRET=

# Admin access
ADMIN_EMAILS=

# Starter project copied into each account once. Leave blank to disable.
STARTER_PROJECT_TEMPLATE_ID=

# Pipeline doc allowlist
PIPELINE_DOC_ALLOWED_EMAILS=
NEXT_PUBLIC_PIPELINE_DOC_ALLOWED_EMAILS=

# Integrations
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional app tuning
COST_MARKUP_PERCENTAGE=35
PERFORMANCE_LEVEL=
NEXT_PUBLIC_SAVE_EXPORT_LOCALLY=false
