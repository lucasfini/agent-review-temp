# AudioRepurpose production environment
# Copy to .env.production on the Droplet and replace every placeholder.

# Public app URL / domain
APP_DOMAIN=audiorepurpose.com
NEXT_PUBLIC_APP_URL=https://audiorepurpose.com
ACME_EMAIL=replace-with-your-acme-email@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# AI providers
# At least one AssemblyAI credential must be set.
ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-api-key
ASSEMBLYAI_ACCESS_KEY=
OPENAI_API_KEY=replace-with-your-openai-api-key
# Backward compatibility only for older references.
OPENAI_API_KEY_OPTIN=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Anthropic is optional. Leave it blank if the app is OpenAI-only.

# Billing
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# Contact email delivery (Microsoft 365 SMTP shown as example)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lucas@audiorepurpose.com
SMTP_PASS=replace-with-your-mailbox-password
CONTACT_FROM_EMAIL=support@audiorepurpose.com
CONTACT_TO_EMAIL=support@audiorepurpose.com

# Storage
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET_NAME=replace-with-your-r2-bucket-name

# Internal auth / scheduled jobs
CRON_SECRET=replace-with-a-random-secret
INTERNAL_JOB_SECRET=replace-with-a-random-secret
UPLOAD_TOKEN_SECRET=replace-with-a-random-secret

# Admin / demo
ADMIN_EMAILS=
DEMO_EMAIL=
DEMO_PASSWORD=
NEXT_PUBLIC_DEMO_PASSWORD=
DEMO_RESEED_SECRET=

# Pipeline doc allowlist
PIPELINE_DOC_ALLOWED_EMAILS=
NEXT_PUBLIC_PIPELINE_DOC_ALLOWED_EMAILS=

# Integrations
# Leave these blank for day-one launch if Zoom/Microsoft imports are deferred.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://audiorepurpose.com/api/integrations/zoom/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://audiorepurpose.com/api/integrations/microsoft/callback

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional app tuning
COST_MARKUP_PERCENTAGE=35
PERFORMANCE_LEVEL=
NEXT_PUBLIC_SAVE_EXPORT_LOCALLY=false
