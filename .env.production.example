# AudioRepurpose production environment
# Copy to .env.production on the Droplet and replace every placeholder.

# Public app URL / domain
APP_DOMAIN=audiorepurpose.com
NEXT_PUBLIC_APP_URL=https://audiorepurpose.com
ACME_EMAIL=replace-with-your-acme-email@example.com
# Optional server-to-server base URL override. Leave blank to use app defaults.
INTERNAL_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# AI providers
# At least one AssemblyAI credential must be set.
ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-api-key
ASSEMBLYAI_ACCESS_KEY=
OPENAI_API_KEY=replace-with-your-openai-api-key
# Backward compatibility only for older references.
OPENAI_API_KEY_OPTIN=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Anthropic is optional. Leave it blank if the app is OpenAI-only.

# Billing
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
# Subscription Stripe price IDs are stored in plans.stripe_price_id, not env vars.
# Keep dry_run until launch approval explicitly enables blocking enforcement.
SUBSCRIPTION_ENFORCEMENT_MODE=dry_run
# Optional subscription redirect overrides. Leave blank to use app defaults.
STRIPE_SUBSCRIPTION_SUCCESS_URL=
STRIPE_SUBSCRIPTION_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=

# Contact email delivery (Resend)
RESEND_API_KEY=replace-with-your-resend-api-key
CONTACT_FROM_EMAIL=support@audiorepurpose.com
CONTACT_TO_EMAIL=support@audiorepurpose.com
# Optional: only needed if paused legacy agency lead-capture APIs are intentionally active.
AGENCY_LEAD_FROM_EMAIL=replace-with-your-verified-agency-from-email
AGENCY_LEAD_NOTIFICATION_EMAIL=replace-with-your-agency-notification-email
# Set only if those legacy APIs are intentionally active.
AGENCY_LEAD_ORGANIZATION_ID=replace-with-internal-agency-organization-id

# Optional private internal agency Slack integration
SLACK_CLIENT_ID=replace-with-your-slack-client-id
SLACK_CLIENT_SECRET=replace-with-your-slack-client-secret
SLACK_REDIRECT_URI=https://audiorepurpose.com/api/agency/slack/oauth/callback
# Optional explicit OAuth state secret; defaults to INTEGRATIONS_ENCRYPTION_KEY or SLACK_CLIENT_SECRET.
SLACK_OAUTH_STATE_SECRET=
# Not currently used unless Slack events/interactivity are added.
SLACK_SIGNING_SECRET=

# Integration token encryption
# Generate 32 bytes as base64 or 64 hex chars. Never commit a real value.
INTEGRATIONS_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-hex-key

# Storage
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET_NAME=replace-with-your-r2-bucket-name

# Internal auth / scheduled jobs
CRON_SECRET=replace-with-a-random-secret
INTERNAL_JOB_SECRET=replace-with-a-random-secret
UPLOAD_TOKEN_SECRET=replace-with-a-random-secret

# Admin access
ADMIN_EMAILS=

# Starter project copied into each account once. Leave blank to disable.
STARTER_PROJECT_TEMPLATE_ID=replace-with-starter-template-project-id

# Pipeline doc allowlist
PIPELINE_DOC_ALLOWED_EMAILS=
NEXT_PUBLIC_PIPELINE_DOC_ALLOWED_EMAILS=

# Integrations
# Leave these blank for day-one launch if Zoom/Microsoft imports are deferred.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://audiorepurpose.com/api/integrations/zoom/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://audiorepurpose.com/api/integrations/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://audiorepurpose.com/api/integrations/youtube/callback

# Durable rate limiting
UPSTASH_REDIS_REST_URL=replace-with-your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-redis-rest-token

# Optional app tuning
COST_MARKUP_PERCENTAGE=35
PERFORMANCE_LEVEL=
NEXT_PUBLIC_SAVE_EXPORT_LOCALLY=false
